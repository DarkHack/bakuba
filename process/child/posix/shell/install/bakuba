cmdList="cmdSh cmdEcho cmdPrintf cmdCat cmdSleep cmdKill cmdBase64 cmdOpenssl cmdShuf"

for cmd in $cmdList;do
 if [ -z "$(eval echo \$$cmd)" ];then echo "[FATAL] missing cmd:$cmd";exit 1;fi
done

shLog="init-install"
shDebugEnable="1"
shDebug "$*"

shDebug 1 "$racine/bakuba/global/vars"
for param in $*;do
 if [ "$param" = "force_initv" ];then 
  force_initv=1;
  shDebug 1 "force_initv"
 fi
done
$(shInclude $racine/bakuba/global/vars)
shLog="$pName-install:"

shDebug "[ INFO ] $racine/chroot/lib-sh/chroot && $racine/systemctl/lib-sh/systemctl && shInclude $racine/rsyslog/lib-sh/rsyslog"
$(shInclude $racine/chroot/lib-sh/chroot) && $(shInclude $racine/systemctl/lib-sh/systemctl) && $(shInclude $racine/rsyslog/lib-sh/rsyslog)

