cmdList="cmdPrintf cmdCat cmdBase64 cmdLz4"

shErrorOnMissing $cmdList

# $cmdPrintf "coucou" | shLz4Compress64
# echo "coucou" | lz4 -c - | base64
shLz4Compress64() {
 local shLogfunc="shLz4Compress64"
 shLog $shLog_TRACE "$shLogfunc" >&2
 
 $cmdCat <&0 | $cmdLz4 -c - | $cmdBase64
}
# $cmdPrintf "BCJNGGRApwcAAIBjb3Vjb3UKAAAAACKI45M=" | shLz4UnCompress64
# echo "BCJNGGRApwcAAIBjb3Vjb3UKAAAAACKI45M=" | base64 -d | lz4 -d -c -
shLz4UnCompress64() {
 local shLogfunc="shLz4Compress64"
 shLog $shLog_TRACE "$shLogfunc" >&2
 
 $cmdCat <&0 | $cmdBase64 -d | $cmdLz4 -d -c -
}
