cmdList="cmdSh cmdEcho cmdPrintf cmdTr cmdCat cmdMkdir"

for cmd in $cmdList;do
 if [ -z "$(eval echo \$$cmd)" ];then echo "[FATAL] missing cmd:$cmd";exit 1;fi
done
if type "shInclude" > /dev/null; then
 shDebug 2 "shTools ever include"
 return ;
fi

if [ ! -d "/ram" ];then $cmdMkdir "/ram";fi
if [ -f "/etc/fstab" ];then
 if [ -z "$(cat /etc/fstab | grep '^tmpfs' | grep '/ram')" ];then
  ramSize="$(($(free -m | grep '^Mem' | tr -s '[:blank:]' ' ' | cut -f 2 -d ' ' | tr -d 'M')* 1 / 100))"
  $cmdPrintf "tmpfs                                           /ram    tmpfs   defaults,size=${ramSize}M        0       0" >> /etc/fstab
  mount -a
 fi
fi
shTmpDir="/ram/shtools"
shPsFile="$shTmpDir/$$.ps"
if [ -f "$shPsFile" ];then
 shIncludeFileEverInclude=""
 if [ -f "$shIncludeBddFile" ];then shIncludeFileEverInclude="$(cat $shIncludeBddFile)";fi
 return ;
else
 if [ ! -d "$shTmpDir" ];then mkdir -p $shTmpDir;fi
 echo "$(ps -p $$ -o comm=)" > $shPsFile 2>&1
 for dirtyFile in $(ls $shTmpDir/*.ps 2>/dev/null);do
  dirtyPid=$(echo $dirtyFile | rev | cut -d'/' -f 1 | rev | cut -d '.' -f 1)
  newName="$(ps -p $dirtyPid -o comm= 2>&1)"
  if [ -z "$newName" ] || [ ! "$(cat $dirtyFile 2>&1)" = "$newName" ];then
   rm $shTmpDir/$dirtyPid.* 2>&1 >> /dev/null
  fi
 done
fi

shIncludeBddFile="$shTmpDir/$$.include"
export shIncludeFileEverInclude
export shIncludeInWorkingFile

shDebugHiddenMemory="$shTmpDir/$$.hiddendebug"
export shDebugHiddenMemory

#type mailSend 2>&1 >> /dev/null || . $racine/lib-sh/mailTools

# error from 'shExecute' or 'shExecuteNoLog'
