cmdSh="$(which sh)"
 
#systemctl_create $pName
systemctl_create() {
 local log="systemctl_create:"
 local pName="$1"
 if [ -z "$cmdSystemctl" ];then
  initv_create "$pName"
 else
  if [ -n "$($cmdSystemctl status ${pName}* | head -n 3 | tail -n 1 | grep running)" ];then
   shDebug 1 ""$log" service $pName is running, we stop them."
   $cmdSystemctl stop $pName
   $cmdSystemctl stop ${pName}@*
  fi
 fi
}
#initv_create $pName
initv_create() {
 local log="initv_create:"
 local pName="$1"
 shDebug 1 ""$log" not systemctl system, gone to initV"
 /etc/init.d/$pName stop
}
 
