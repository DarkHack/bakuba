cmdList="cmdSh cmdEcho cmdPrintf cmdCat cmdTr cmdWc cmdLs"

shErrorOnMissing $cmdList

shAgentCpt=0

fragmentCompressBuffer=""
# echo "coucou" | lz4 -c - | base64
shAgentFragmentCompressed() {
 local shLogfunc="shAgentFragmentCompressed($shAgentCpt)"
 shLog $shLog_TRACE "$shLogfunc"
 local requestJson="$($cmdCat <&0 | $cmdBase64 -d -i 2>/dev/null)"
 local requestJsonNext="$($cmdPrintf "$requestJson" | jsonInObjectRead "next")"
 local requestJsonIndex="$($cmdPrintf "$requestJson" | jsonInObjectRead "index")"
 local reponseJson="$($cmdPrintf "{}" | jsonInObjectWrite "index" "$requestJsonIndex")"
 local fragmtData="$($cmdPrintf "$requestJson" | jsonInObjectRead "data")"
 
 shLog $shLog_TRACE "$shLogfunc index:$requestJsonIndex next:$requestJsonNext $($cmdPrintf "$fragmtData" | $cmdWc -c)/$($cmdPrintf "$fragmentBuffer" | $cmdWc -c)"
 if [ "true" = "$requestJsonNext" ];then
  fragmentBuffer="${fragmentBuffer}${fragmtData}"
  shLog $shLog_TRACE "$shLogfunc ask next"
  $cmdPrintf "$reponseJson" | shCryptoControllerRequest "ShAgent" | shAgentFragmentCompressed &
 else
  fragmentBuffer="${fragmentBuffer}${fragmtData}"
  shLog $shLog_TRACE "$shLogfunc execute"
  local toExecute="$fragmentBuffer"
  fragmentBuffer=""
  eval "$($cmdPrintf "$toExecute" | $cmdBase64 -d -i 2>/dev/null)" &
 fi
}
# echo "$json64Fragment" | shAgentFragment
fragmentBuffer=""
fragmentBufferSize=0
shAgentFragment() {
 local shLogfunc="shAgentFragment($shAgentCpt)"
 local requestJson="$($cmdCat <&0 | $cmdBase64 -d -i 2>/dev/null)"
 shLog $shLog_TRACE "$shLogfunc \r\n $requestJson"
 local requestJsonNext="$($cmdPrintf "$requestJson" | jsonInObjectRead "next")"
 local requestJsonIndex="$($cmdPrintf "$requestJson" | jsonInObjectRead "index")"
 local requestJsonOrderId="$($cmdPrintf "$requestJson" | jsonInObjectRead "orderId")"
 local reponseJson="$($cmdPrintf "{}" | jsonInObjectWrite "index" "$requestJsonIndex")"
 local reponseJson="$($cmdPrintf "$reponseJson" | jsonInObjectWrite "orderId" "$requestJsonOrderId" )"
 local fragmtData="$($cmdPrintf "$requestJson" | jsonInObjectRead "data")"
 
 if [ -z "$fragmentBuffer" ];then
 	$cmdPrintf "$fragmtData" | $cmdBase64 -d -i 2>/dev/null > /tmp/fragmentShell.log
 else
 	$cmdPrintf "$fragmtData" | $cmdBase64 -d -i 2>/dev/null >> /tmp/fragmentShell.log
 fi
 fragmentBuffer="${fragmentBuffer}$( $cmdPrintf "$fragmtData" | $cmdBase64 -d -i 2>/dev/null )"
 local fragmtSize="$($cmdPrintf "$fragmtData" | $cmdWc -c)"
 fragmentBufferSize=$(( fragmentBufferSize + fragmtSize ))
 shLog $shLog_TRACE "$shLogfunc index:$requestJsonIndex next:$requestJsonNext $fragmtSize/$fragmentBufferSize"
 if [ "true" = "$requestJsonNext" ];then
  shLog $shLog_TRACE "$shLogfunc ask next"
  $cmdPrintf "$reponseJson" | shCryptoControllerRequest "ShAgent" | shAgentResponse &
 else
  local toExecute="$fragmentBuffer"
  fragmentBuffer=""
  fragmentBufferSize=0
  shLog $shLog_TRACE "$shLogfunc execute :$requestJsonOrderId"
  
  eval "$toExecute" 2>&1 || {
    shLog $shLog_TRACE "$shLogfunc echec!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
  }
#  eval "$toExecute" 2>&1 | {
#   shLog $shLog_TRACE "$shLogfunc :$reponseJson" >&2
#   result64="$($cmdCat <&0 | $cmdBase64 | $cmdTr -d '\n')";
#   local reponseJson=$($cmdPrintf "$reponseJson" | jsonInObjectWrite "result" "$result64" )
#   $cmdPrintf "$reponseJson" | shCryptoControllerRequest "ShAgent" | shAgentResponse &
#  } || {
#   reponseJson=$($cmdPrintf "$reponseJson" | jsonInObjectWrite "result" "echec on execute" )
#   $cmdPrintf "$reponseJson" | shCryptoControllerRequest "ShAgent" | shAgentResponse &
#  }
 fi
}
shAgentExecute() {
 local shLogfunc="shAgentExecute($shAgentCpt)"

 local requestJson="$($cmdCat <&0 | $cmdBase64 -d -i 2>/dev/null)"
 local orderId="$($cmdPrintf "$requestJson" | jsonInObjectRead "orderId")"
 local reponseJson="$($cmdPrintf {} | jsonInObjectWrite "orderId" "$orderId")"
 
 shLog $shLog_TRACE "$shLogfunc $orderId" >&2
 #shLog $shLog_TRACE "$shLogfunc $requestJson $($cmdPrintf "$requestJson" | jsonInObjectRead "eval" | $cmdBase64 -d -i 2>/dev/null)" >&2
 
 eval "$($cmdPrintf "$requestJson" | jsonInObjectRead "eval" | $cmdBase64 -d -i 2>/dev/null )" 2>&1 | {
  local receive=""
  local reponseJson=$($cmdPrintf "$reponseJson" | jsonInObjectWrite "end" "false" )
  #result64="$($cmdCat <&0 | $cmdBase64 | $cmdTr -d '\n')";
  while read packet;do
   local receive="${receive}${packet}\n";
   if [ 8000 -lt $($cmdPrintf "$receive" | $cmdWc -c ) ];then
    local result64="$($cmdPrintf "$receive\n" | $cmdBase64 | $cmdTr -d '\n')";
	local receive="";
	local reponseJson=$($cmdPrintf "$reponseJson" | jsonInObjectWrite "result" "$result64" )
    shLog $shLog_TRACE "$shLogfunc:\n $reponseJson" >&2
    $cmdPrintf "$reponseJson" | shCryptoControllerRequest "ShAgent" | shAgentResponse
   fi
  done
  local result64="$($cmdPrintf "$receive\n" | $cmdBase64 | $cmdTr -d '\n')";
  local reponseJson=$($cmdPrintf "$reponseJson" | jsonInObjectWrite "result" "$result64" )
  local reponseJson=$($cmdPrintf "$reponseJson" | jsonInObjectWrite "end" "true" )
  shLog $shLog_DEBUG "$shLogfunc:\n $reponseJson" >&2;
  $cmdPrintf "$reponseJson" | shCryptoControllerRequest "ShAgent" | shAgentResponse &
 } || {
   reponseJson=$($cmdPrintf "$reponseJson" | jsonInObjectWrite "result" "echec on execute" )
   $cmdPrintf "$reponseJson" | shCryptoControllerRequest "ShAgent" | shAgentResponse &
 }
 shLog $shLog_TRACE "$shLogfunc : $orderId END" >&2
}
shAgentResponse() {
 shAgentCpt=$((shAgentCpt + 1))
 local shLogfunc="shAgentResponse($shAgentCpt)"
 shLog $shLog_TRACE "$shLogfunc: read" >&2;
 local receive="$($cmdCat <&0)";
 while read packet;do local receive="${receive}${packet}";shLog $shLog_DEBUG "$shLogfunc: packet:\n$packet" >&2;done
 
 if [ -z "$receive" ];then
  shLog $shLog_ERROR "$shLogfunc: reception empty:$receive" >&2;
 else
  shLog $shLog_TRACE "$shLogfunc: reception($($cmdPrintf $receive | $cmdWc -c ))" >&2;
  eval "$($cmdPrintf "$receive" | $cmdBase64 -d -i 2>/dev/null)" || shLog $shLog_TRACE "$shLogfunc: echec on execute:$receive)" >&2 &
 fi
 shLog $shLog_TRACE "$shLogfunc: end" >&2;
}
shAgentRun() {
 local shLogfunc="shAgentRun($shAgentCpt)"
 
 shLog $shLog_TRACE "$shLogfunc" >&2
 
 local reponseJson="{}"
 local reponseJson=$($cmdPrintf "$reponseJson" | jsonInObjectWrite "uptime" "$($cmdUptime | $cmdBase64 | $cmdTr -d '\n' )" )
 
 $cmdPrintf "$reponseJson" | shCryptoControllerRequest "ShAgent" | shAgentResponse
 $cmdPrintf "/ shAgentRun($shAgentCpt) -----\r\n"
}
