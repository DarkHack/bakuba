cmdList="cmdSh cmdCat cmdTimeout cmdTr cmdXargs cmdCut cmdWget cmdBase64 cmdEcho cmdPrintf"
cmdList="$cmdList cmdRm cmdMktemp cmdMkfifo"
cmdList="$cmdList cmdOpenssl"

for cmd in $cmdList;do
 if [ -z "$(eval echo \$$cmd)" ];then echo "[FATAL] missing cmd:$cmd";exit 1;fi
done
testPipe="$(shPipeInit)"
shPipeOpen $testPipe

shLog $shLog_INFO "testPipe:$testPipe" >&2

$cmdPrintf "testPipe:$testPipe" | shPipeWrite $testPipe

shPipeTest() {
 local shLogfunc="shPipeTest()"
 shLog $shLog_INFO "$shLogfunc" >&2
 testPipe2="$(shPipeInit)"
 shPipeOpen $testPipe2
 testPipe3="$(shPipeInit)"
 
 shLog $shLog_TRACE "$shLogfunc write low level $testPipe $testPipe2 $testPipe3" >&2
 shPipeRead $testPipe
 $cmdPrintf "testPipe:$testPipe" | shPipeWrite $testPipe2 none
 $cmdPrintf "testPipe2:$testPipe2" | shPipeWrite $testPipe2 none
 $cmdPrintf "testPipe3:$testPipe3" | shPipeWrite $testPipe2
 shPipeRead $testPipe2
# shLog $shLog_TRACE "$shLogfunc write $testPipe" >&2
# $cmdPrintf "coucou" | shPipeWrite $testPipe
}
