#!/bin/sh

cmdList="cmdTr cmdCut cmdEcho cmdPrintf"
for cmd in $cmdList;do
 if [ -z "$(eval $cmdPrintf \$$cmd)" ];then $cmdPrintf "missing cmd:$cmd for lib-sh/json";exit 1;fi
done

# jsonValue=$($cmdPrintf "$jsonData" | jsonInObjectRead "$jsonKey")
# jsonData=$($cmdPrintf "$jsonData" | jsonInObjectWrite "$jsonKey" "$jsonValue")

jsonInObjectRead() {
 local log="jsonInObjectRead:"
 
 local jsonData=""
 while read data; do
  local jsonData="${data}${jsonData}"
 done
 
 local dataObject="$($cmdPrintf $jsonData | $cmdCut -d'{' -f2 | $cmdCut -d'}' -f1 | $cmdTr ' ' '¤' )"
 local name="$1"
 
 for data in $($cmdPrintf $dataObject | $cmdTr ',' ' ');do
   local dataName="$($cmdPrintf $data | $cmdCut -d: -f1 | $cmdCut -d\" -f2 | $cmdTr -d '¤')"
#   $cmdPrintf "dataName:$dataName"
   if [ "$dataName" = "$name" ];then
#    local dataVal="$($cmdPrintf $data | $cmdCut -d: -f2-)"
#    $cmdPrintf $dataVal
    $cmdPrintf $data | $cmdCut -d: -f2- | $cmdCut -d\" -f2 | $cmdTr '¤' ' '
    break;
   fi
 done
}

jsonInObjectWrite() {
 local log="jsonInObjectWrite:"
 
 local jsonData=""
 while read data; do
  local jsonData="${data}${jsonData}"
 done
 
 local dataObject="$($cmdPrintf $jsonData | $cmdCut -d'{' -f2 | $cmdCut -d'}' -f1 | $cmdTr ' ' '¤' )"
 local name="$1"
 local value="$2"
 local newDataObject=""

 local writed=0
 for data in $($cmdPrintf $dataObject | $cmdTr ',' ' ');do
   local dataName="$($cmdPrintf $data | $cmdCut -d: -f1 | $cmdCut -d\" -f2)"
   if [ "$dataName" = "$name" ];then
    if [ -z "$newDataObject" ];then
     local newDataObject="\"$name\":\"$value\""
    else
     local newDataObject="\"$name\":\"$value\",$newDataObject"
    fi
    local writed=1
   else
    if [ -z "$newDataObject" ];then
     local newDataObject="$data"
    else
     local newDataObject="$data,$newDataObject"
    fi
   fi
 done
 if [ "$writed" -eq 0 ];then
  if [ -z "$newDataObject" ];then
   local newDataObject="\"$name\":\"$value\""
  else
   local newDataObject="\"$name\":\"$value\",$newDataObject"
  fi
 fi
 $cmdPrintf "{$newDataObject}" | $cmdTr '¤' ' '
}

