cptPipe=3
shCryptInitPipe() {
 PIPE_passCrypt="$($cmdMktemp -u)"
 $cmdMkfifo $PIPE_passCrypt
 if [ $cptPipe -eq 3 ];then
  exec 3<>$PIPE_passCrypt
 elif [ $cptPipe -eq 4 ];then
  exec 4<>$PIPE_passCrypt
 elif [ $cptPipe -eq 5 ];then
  exec 5<>$PIPE_passCrypt
 elif [ $cptPipe -eq 6 ];then
  exec 6<>$PIPE_passCrypt
 elif [ $cptPipe -eq 7 ];then
  exec 7<>$PIPE_passCrypt
 elif [ $cptPipe -eq 8 ];then
  exec 8<>$PIPE_passCrypt
 elif [ $cptPipe -eq 9 ];then
  exec 9<>$PIPE_passCrypt
 else
  $cmdPrintf "echec no more 7 pipe secure."
 fi
 $cmdRm $PIPE_passCrypt
# $cmdPrintf $cptPipe
 cptPipe=$(( cptPipe+1 )) ;
}
shCryptWritePipe() {
 idxPipe="$1"
 read data
 if [ $idxPipe -eq 3 ];then
  $cmdPrintf "$data" >&3
 elif [ $idxPipe -eq 4 ];then
  $cmdPrintf "$data" >&4
 elif [ $idxPipe -eq 5 ];then
  $cmdPrintf "$data" >&5
 elif [ $idxPipe -eq 6 ];then
  $cmdPrintf "$data" >&6
 elif [ $idxPipe -eq 7 ];then
  $cmdPrintf "$data" >&7
 elif [ $idxPipe -eq 8 ];then
  $cmdPrintf "$data" >&8
 elif [ $idxPipe -eq 9 ];then
  $cmdPrintf "$data" >&9
 else
  $cmdPrintf "echec no more 7 pipe secure."
 fi
}
shCryptListCiphers() {
 local debug="$1"
 shCryptTestCiphers "$shCryptciphers" "$debug"
}
shCryptTestCiphers() {
 local tCiphers="$1"
 local debug="$2"
 local ciphers=""
 local passTest="uneTestMotDePasse"
 
 shCryptInitPipe
 local cryptPassPipe=$(( cptPipe-1 ))
 for cipher in $($cmdPrintf $tCiphers | $cmdTr ':' ' ' );do
  $cmdPrintf "$passTest" | shCryptWritePipe $cryptPassPipe
  cryptData="$($cmdPrintf data | shCryptEncode $cipher $cryptPassPipe)"
  $cmdPrintf "$passTest" | shCryptWritePipe $cryptPassPipe
  clearData="$($cmdPrintf $cryptData | shCryptDecode $cipher $cryptPassPipe)"
  if [ "$clearData" = "data" ];then
    local ciphers="$cipher:$ciphers"
    if [ -n "$debug" ];then $cmdPrintf "accept $cipher \n$cryptData\n$clearData";fi
  else
    if [ -n "$debug" ];then $cmdPrintf "reject $cipher \n$cryptData\n$clearData";fi
  fi
 done
 $cmdPrintf $ciphers
}
shCryptCommonCiphers() {
 local mCiphers="$1"
 local sCiphers="$2"
 local ciphers=""
 for mCipher in $($cmdPrintf $mCiphers | $cmdTr -d '\n' | $cmdTr ':' ' ' );do
  for sCipher in $($cmdPrintf $sCiphers | $cmdTr -d '\n' | $cmdTr ':' ' ' );do
   if [ "$mCipher" = "$sCipher" ];then
    local ciphers="$mCipher:$ciphers"
   fi
  done
 done
 $cmdPrintf $ciphers
}
shCryptRandomASCCI() {
 local length="$1"
 local randomStr="";
 local cpt=0;
 if [ ! $length -gt $cpt ];then echo "no length"
 else
  while [ $length -gt $cpt ];do
   type="$($cmdShuf -i 0-2 -n 1)"
   case "$type" in 
    0) local range="65-90";;
    1) local range="97-122";;
    2) local range="48-57";;
   esac
   randomStr="$randomStr$(printf \\$(printf '%03o' $($cmdShuf -i $range -n 1) ))"
   cpt=$(( cpt+1 ))
  done
 fi
 $cmdPrintf $randomStr
}
shCryptRandomCipher() {
 local cryptCiphers="$1"
 shCryptGetCipher "$($cmdShuf -i 1-$(shCryptCountCiphers \"$cryptCiphers\") -n 1)" "$cryptCiphers"
}
shCryptCountCiphers() {
 local ciphers="$1"
 local cpt=0

 for cipher in $($cmdPrintf $ciphers | $cmdTr -d '\n' | $cmdTr ':' ' ' );do
  if [ -n "$cipher" ];then local cpt=$(( cpt+1 ));fi
 done
 $cmdPrintf "$cpt"
}
shCryptGetCipher() {
 local index="$1"
 local ciphers="$2"
 local cpt=1

 for cipher in $($cmdPrintf $ciphers | $cmdTr -d '\n' | $cmdTr ':' ' ' );do
  [ $cpt -eq $index ] && $cmdPrintf "$cipher" && break || cpt=$(( cpt+1 )) ;
 done
}
shCryptDecode() {
 local cipher=$1
 local pass=$2
 local decrypt_cmd="$cmdOpenssl enc -$cipher -d -pass fd:$pass"
 
 read data64
 
 $cmdPrintf $data64 | $cmdTr -d '\r' | $cmdTr -d '\n' | $cmdTr -d ' ' | $cmdBase64 -d -i 2>/dev/null | $decrypt_cmd 2>/dev/null | $cmdTr -d ' ' | $cmdTr -d '\r' | $cmdTr -d '\n' | $cmdBase64 -d -i 2>/dev/null
}

shCryptEncode() {
 local cipher=$1
 local pass=$2
 local encrypt_cmd="$cmdOpenssl enc -$cipher -salt -pass fd:$pass"
 
 read data
 
 $cmdPrintf $data | $cmdBase64 | $encrypt_cmd 2>/dev/null | $cmdBase64 | $cmdTr -d '\r' | $cmdTr -d '\n' | $cmdTr -d ' '
}


